# The web app talks to the API same-origin through the Vite proxy (dev) or nginx (Docker).
# Defaults to the shared API_PREFIX from @library/contracts (/api/v1); set only to point elsewhere.
# VITE_API_BASE=/api/v1
# Where the Vite dev proxy forwards /api (only used by `pnpm dev`).
VITE_DEV_API_TARGET=http://localhost:4000
