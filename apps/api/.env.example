# Copy to .env for local development (pnpm dev). Docker Compose sets these itself.

# --- server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false

# --- database (compose `db` service on the host port 55432) ---
DATABASE_URL=postgresql://library:library@localhost:55432/library
# Used by the API integration tests (created on demand by the test globalSetup).
DATABASE_URL_TEST=postgresql://library:library@localhost:55432/library_test

# --- seed ---
# always | if-empty | never — what the API does on start-up after `prisma migrate deploy`.
SEED_ON_START=if-empty

# --- auth (Phase 4) ---
JWT_ACCESS_SECRET=dev-only-change-me-32-chars-minimum!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# --- AI (Phase 11). Model ids are env-only; these are suggestions, not code defaults. ---
# bedrock | kimi | openai-compatible | anthropic | mock
AI_PROVIDER=mock
# Optional: a different provider for the strong tier. Its model id is <PROVIDER>_MODEL_STRONG
# when set (KIMI_MODEL_STRONG, BEDROCK_MODEL_STRONG, …), else AI_MODEL_STRONG; per-provider ids
# always win, and the eval reads the same keys. Confirmed setup (Sonnet 5 / 5.5 are listed in the
# EU but refused for this account, 2026-10-02):
#   AI_PROVIDER=bedrock  AI_MODEL_SMALL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
#   AI_PROVIDER_STRONG=kimi  KIMI_MODEL_STRONG=kimi-k3
AI_PROVIDER_STRONG=
AI_MODEL_SMALL=
AI_MODEL_STRONG=
# The tier the chat agent runs on. small (Haiku 4.5) by default: on the 29 agent cases it kept
# every deterministic check at 100 % with p50 3.4 s / p95 5.4 s, against Kimi K3's 17 s / 39 s
# (2026-10-02, DECISIONS.md). strong puts chat on the strong tier.
AI_CHAT_TIER=small
AI_TEMPERATURE_SMALL=0
AI_TEMPERATURE_STRONG=0.3
AI_CONFIRM_SECRET=dev-only-change-me-32-chars-minimum!!

# bedrock: Claude through Amazon Bedrock with IAM (standard AWS credential chain). Claude 4.5+
# models need a cross-region inference profile id on bedrock-runtime (bare ids are refused);
# from eu-central-1 the EU geo profiles below keep data inside EU regions (+10 % over `global.`).
# Ids from the AWS model cards, 2026-10-01; verify with `pnpm --filter @library/ai check:bedrock`.
#   AWS_REGION=eu-central-1
#   AI_MODEL_SMALL=eu.anthropic.claude-haiku-4-5-20251001-v1:0     # $1 / $5 per MTok (list; EU geo ×1.1)
#   AI_MODEL_STRONG=eu.anthropic.claude-sonnet-5-5                  # $2 / $10 per MTok (list; EU geo ×1.1)
# Verified 2026-10-01 with `pnpm --filter @library/ai check:bedrock`: Haiku 4.5 forced tool OK,
# prompt caching OK (≥ 4,096-token prefix); Sonnet 5.5 → 403 "not available for this account"
# (use AI_PROVIDER_STRONG=kimi until access is granted).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# kimi (development): Moonshot's OpenAI-compatible endpoint (base URL defaults to this one)
#   OPENAI_COMPAT_BASE_URL=https://api.moonshot.ai/v1
#   AI_MODEL_SMALL=kimi-k2.6     # $0.95 in / $4 out per MTok, cache hit $0.16 (platform.kimi.ai, 2026-10-01)
#   AI_MODEL_STRONG=kimi-k3      # $3 in / $15 out per MTok, cache hit $0.30
# Verified 2026-10-01: both are thinking models — they accept only temperature 1 (the provider
# adopts it after the first 400) and refuse a forced tool (the provider uses the documented
# auto + "must call" fallback from the start); prefix caching is automatic.
#   AI_TEMPERATURE_SMALL=1
#   AI_TEMPERATURE_STRONG=1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# anthropic (direct API, thin variant of the Bedrock provider)
#   AI_MODEL_SMALL=claude-haiku-4-5-20251001
#   AI_MODEL_STRONG=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- embeddings: bedrock | local | mock ---
#   bedrock → the model decides the family:
#             cohere.embed-multilingual-v3, EMBEDDING_DIMENSIONS=1024 — the recommended one (2026-10-02:
#               best multilingual recall on the 49-case eval, cutoff 0.44; on demand in eu-central-1)
#             eu.cohere.embed-v4:0 (EU inference profile), 256|512|1024|1536 dims
#             amazon.titan-embed-text-v2:0 (or empty), 256|512|1024 dims ($0.02 / MTok)
#   local   → Xenova/bge-small-en-v1.5 (384 dims, ONNX inside the API; TRANSFORMERS_CACHE for the model files)
#   mock    → hashed features, EMBEDDING_DIMENSIONS dims
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
TRANSFORMERS_CACHE=
# Natural-language search prompt: compact by default; `true` adds ~60 examples and a genre guide
# so the prefix clears Haiku's 4,096-token cache minimum (cheaper only at several searches per
# 5 minutes — measured numbers in DECISIONS.md).
NL_SEARCH_CACHE_PADDING=false
# Hybrid search (GET /ai/search): rerank the fused top 20 with the small model by default. Off:
# measured +0 recall@5 and +1 hit@1 in 24 queries for ~$0.003 and ~0.9 s per search (DECISIONS.md);
# a request can still ask with ?rerank=true.
HYBRID_SEARCH_RERANK=false
# Embed changed books on API start (hash-diffed; a no-op when everything is current).
EMBED_SYNC_ON_START=true
# …and every N ms after (0 = start-up only); heals a reseed under a running API within a minute.
EMBED_SYNC_INTERVAL_MS=60000
# /ready answers 503 NOT_READY (reason embeddings_pending) until every active book has a vector for
# the configured model; the probe starts the catch-up sync. false = database ping only (use while a
# real embedding provider is down: the stack still comes up, search falls back to lexical).
READY_REQUIRE_EMBEDDINGS=true
# Document expansion: embed each book with a French and an Arabic summary written by the small
# model (one call per book, regenerated only when the book changes). off | fr-ar
EMBEDDING_EXPANSION=off
# Hybrid search: minimum cosine similarity for a semantic hit. Unset = the model's calibrated
# default (Cohere multilingual v3 0.44, Cohere v4 0.30, Titan v2 none, Mock 0.33; see DECISIONS.md);
# 0 disables the cutoff (calibration).
HYBRID_MIN_SIMILARITY=
# AI endpoints: calls per RATE_LIMIT_WINDOW_MS per client.
RATE_LIMIT_AI_MAX_REQUESTS=30

# --- voice agent (Phase 13.2): off | mock | nova-sonic ---
# nova-sonic: Amazon Nova 2 Sonic over Bedrock's bidirectional stream, in its own region (there is
# no `eu.` profile; the bare id is used in-region). Model access must be enabled and Bedrock model
# invocation logging must stay off (audio would be stored): checked by `pnpm --filter @library/ai
# voice:step0` (2026-10-02: off). Measured then: ~9.5 speech tokens/s in (silence is billed while
# the mic is open), ~25 out, ~1.2 s from end of speech to first audio, idle close after 55 s
# without audio. Prices per 1K tokens, eu-north-1: speech in $0.00291, out $0.01165.
#   VOICE_PROVIDER=nova-sonic
#   VOICE_MODEL=amazon.nova-2-sonic-v1:0
#   VOICE_AWS_REGION=eu-north-1
VOICE_PROVIDER=off
VOICE_MODEL=
# One polyglot voice for English and French (tiffany or matthew); per-locale voices are the
# fallback if its French is judged poor.
VOICE_ID=tiffany
VOICE_MAX_SECONDS=420
VOICE_IDLE_SECONDS=60
VOICE_MAX_SESSIONS=10
VOICE_SESSIONS_PER_HOUR=6
VOICE_DAILY_SECONDS=600

# --- external lookup: openlibrary | fixture (tests, smoke, offline CI) ---
# fixture serves the Open Library answers recorded by the autofill eval (no network).
LOOKUP_PROVIDER=openlibrary
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
LOOKUP_TIMEOUT_MS=5000

# Scratch database used only by `pnpm db:diff` (must exist; Prisma resets it).
SHADOW_DATABASE_URL=postgresql://library:library@localhost:55432/library_shadow

# --- per-provider model ids (the API, the eval and the contract tests read them) ---
# Each wins over AI_MODEL_* for its provider; the eval's --provider kimi needs both of Kimi's.
# KIMI_MODEL_SMALL=kimi-k2.6
# KIMI_MODEL_STRONG=kimi-k3
# BEDROCK_MODEL_STRONG=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SONNET_TESTS=1     # once Sonnet 5.5 is enabled for the account

# pnpm eval (packages/ai-eval reads this file too). A paid run prints its worst-case estimate and
# refuses above this many dollars before any call. --target http logs in as the demo reader.
EVAL_MAX_COST_USD=3
# EVAL_API_URL=http://localhost:4000
