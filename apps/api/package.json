{
  "name": "@library/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express 5 + Prisma + PostgreSQL API for the library.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dist": "node dist/prisma/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "embed:sync": "tsx src/cli/embedSync.ts",
    "embed:sync:dist": "node dist/src/cli/embedSync.js",
    "postinstall": "node -e \"const fs=require('fs');if(fs.existsSync('prisma/schema.prisma')&&fs.existsSync('node_modules/.bin/prisma'))require('child_process').execFileSync('node_modules/.bin/prisma',['generate'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@library/ai": "workspace:*",
    "@library/contracts": "workspace:*",
    "@library/domain-config": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@library/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
