{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_TEST", "LOG_LEVEL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "smoke": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "coverage": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_TEST", "LOG_LEVEL"],
      "outputs": ["coverage/**"]
    }
  }
}
